import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int q = sc.nextInt();
        int[] queries = new int[q];
        for (int i = 0; i < q; i++) {
            queries[i] = sc.nextInt();
        }

        long[] result = playingWithNumbers(arr, queries);

        for (long val : result) {
            System.out.println(val);
        }
    }

    public static long[] playingWithNumbers(int[] arr, int[] queries) {
        Arrays.sort(arr);
        int n = arr.length;

        long[] prefix = new long[n + 1];
        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + arr[i];
        }

        long[] result = new long[queries.length];
        long totalShift = 0;

        for (int i = 0; i < queries.length; i++) {
            totalShift += queries[i];

            int idx = lowerBound(arr, -totalShift);

            long leftSum = prefix[idx] + (long) idx * totalShift;
            long leftAbs = -leftSum;

            long rightSum = (prefix[n] - prefix[idx]) + (long) (n - idx) * totalShift;

            result[i] = leftAbs + rightSum;
        }

        return result;
    }

    private static int lowerBound(int[] arr, long key) {
        int left = 0, right = arr.length;

        while (left < right) {
            int mid = (left + right) / 2;
            if (arr[mid] < key) left = mid + 1;
            else right = mid;
        }

        return left;
    }
}
